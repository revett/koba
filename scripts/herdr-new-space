#!/usr/bin/env bash
# Picks a project directory with fzf and opens it as a new herdr space, split
# into a terminal (left) and agent (right) pane. Git repositories get a fresh
# worktree on the default branch with Claude (via `cc`) started on the right
# (ctrl-o opens the repository itself instead, with a plain shell). Bound to
# cmd+n as a popup in config/herdr.toml.
set -euo pipefail
source "$(dirname "$0")/herdr-lib.sh"

base="$HOME/projects/github.com"
roots=("$base/revett" "$base/team-plain")

# Worktrees whose space disappeared without cmd+w (herdr's own menu, a crash):
# throw away the safe ones, offer the rest so nothing is stranded.
# An unreadable list would make every worktree look abandoned: bail instead.
list=$("$herdr" workspace list)
jq -e '.result.workspaces | type == "array"' <<< "$list" > /dev/null
open_paths=$(jq -r '.result.workspaces[].worktree.checkout_path // empty' <<< "$list")
stranded=()
for dir in "$WORKTREE_ROOT"/*/*/; do
  dir="${dir%/}"
  [[ -d "$dir" ]] || continue
  grep -qxF "$dir" <<< "$open_paths" && continue
  if [[ -z "$(unsafe_reason "$dir")" ]]; then
    discard_worktree "$dir"
  else
    stranded+=("! ${dir#"$WORKTREE_ROOT"/} · unsaved work")
  fi
done
empty_trash

# Direct children only; not every project is a git repository.
picked=$(
  {
    for entry in "${stranded[@]+"${stranded[@]}"}"; do echo "$entry"; done
    for root in "${roots[@]}"; do
      for dir in "$root"/*/; do
        # Not `&&`: a root with no projects would fail the pipeline.
        [[ -d "$dir" ]] || continue
        echo "${dir#"$base"/}"
      done
    done | sed 's#/$##'
  } | fzf --prompt 'space > ' --reverse --expect ctrl-o \
    --header $'\nenter   New space using a worktree\nctrl-o  New space\n '
) || exit 0

key=$(head -1 <<< "$picked")
choice=$(tail -1 <<< "$picked")
[[ -n "$choice" ]] || exit 0

# Prints the new right hand pane's id. Focus stays on the left unless the
# third argument is --focus.
split() {
  "$herdr" pane split "$1" --direction right --cwd "$2" "${3:---no-focus}" \
    | jq -r '.result.pane.pane_id'
}

# A stranded worktree: reopen it so the work can be dealt with.
if [[ "$choice" == "! "* ]]; then
  dir="$WORKTREE_ROOT/${choice#"! "}"
  dir="${dir%% · *}"
  repo=$(repo_of "$dir")
  pane=$("$herdr" worktree open --cwd "$repo" --path "$dir" --label "$(basename "$dir")" --focus \
    | jq -r '.result.root_pane.pane_id')
  split "$pane" "$dir" > /dev/null
  sort_spaces
  exit 0
fi

repo="$base/$choice"
name=$(basename "$choice")

if [[ "$key" == "ctrl-o" ]] || ! git -C "$repo" rev-parse --git-dir > /dev/null 2>&1; then
  pane=$("$herdr" workspace create --cwd "$repo" --label "$name" --focus \
    | jq -r '.result.root_pane.pane_id')
  split "$pane" "$repo" > /dev/null
  exit 0
fi

read -rp '  name (blank for random) > ' label
# Spaces are named by slug ("On demand SR" becomes "on-demand-sr").
label=$(slugify "${label:-"space-$(openssl rand -hex 2)"}")
dir="$WORKTREE_ROOT/$name/$label"
while [[ -e "$dir" ]]; do dir="$WORKTREE_ROOT/$name/$label-$(openssl rand -hex 2)"; done
echo

# Detached on the freshly fetched default branch; /do's gcb creates the branch.
# A repo with no remote (e.g. chats, kept local on purpose) starts from its
# own HEAD instead.
if git -C "$repo" remote get-url origin > /dev/null 2>&1; then
  start=$(git -C "$repo" symbolic-ref --short refs/remotes/origin/HEAD 2> /dev/null || echo origin/main)
  step "Fetching latest ${start#origin/} from GitHub" git -C "$repo" fetch --quiet origin "${start#origin/}" \
    || printf '    offline? using the last fetched state\n'
else
  start=HEAD
fi
mkdir -p "$(dirname "$dir")"
step "Checking out a fresh copy of $name" git -C "$repo" worktree add --quiet --detach "$dir" "$start"

pane=$("$herdr" worktree open --cwd "$repo" --path "$dir" --label "$label" --focus \
  | jq -r '.result.root_pane.pane_id')
right=$(split "$pane" "$dir" --focus)
"$herdr" pane run "$right" cc > /dev/null
sort_spaces
printf '  ✓ Done\n'
