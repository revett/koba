#!/usr/bin/env bash
# Reports each space's ticket (from its branch) and open PR to the herdr
# sidebar as one $status token, e.g. "ARI-2308 #12380": as one token, a narrow
# sidebar trims its end rather than both halves. Bundled into Herdr.app, which
# runs it every few seconds: spaces whose branch hasn't changed are skipped, so
# GitHub is only asked on a branch change, or for every space with --full
# (which the app passes every couple of minutes, since PRs merge and close
# remotely). It also names each pane's space for the agents list (see below).
set -uo pipefail
source "$(dirname "$0")/herdr-lib.sh"

full=false
[[ "${1:-}" == "--full" ]] && full=true

# Last reported "<id>\t<branch>\t<pr>" per space.
cache="${TMPDIR:-/tmp}/herdr-pr-status.cache"
touch "$cache"
next=$(mktemp)

snapshot=$("$herdr" api snapshot)

# Like Koba, a space's branch is wherever its left hand pane is. One snapshot
# covers every space, so a run that changes nothing stays cheap.
jq -r '
  .result.snapshot as $s
  | $s.workspaces[]
  | .workspace_id as $id | .active_tab_id as $tab
  | ([$s.panes[] | select(.tab_id == $tab)][0].cwd // empty) as $cwd
  | [$id, $cwd] | @tsv' <<< "$snapshot" \
  | while IFS=$'\t' read -r id dir; do
    branch=""
    [[ -n "$dir" ]] && branch=$(git -C "$dir" branch --show-current 2> /dev/null)
    IFS=$'\t' read -r _ last_branch last_pr <<< "$(grep "^$id"$'\t' "$cache")"

    pr="$last_pr"
    if $full || [[ "$branch" != "$last_branch" ]]; then
      pr=""
      if [[ -n "$branch" ]]; then
        pr=$(cd "$dir" && gh pr view "$branch" --json number,state \
          --jq 'select(.state == "OPEN") | "#\(.number)"' 2> /dev/null)
      fi
      status=$(echo $(ticket_from_branch "$branch") $pr)
      # An empty value clears the token; $ticket and $pr came from an earlier
      # version of this script.
      "$herdr" workspace report-metadata "$id" --source koba-status \
        --token "status=$status" --clear-token ticket --clear-token pr > /dev/null
    fi
    printf '%s\t%s\t%s\n' "$id" "$branch" "$pr" >> "$next"
  done

# Spaces that closed drop out of the cache.
mv "$next" "$cache"

# Each pane also gets a $space token naming its space with the repo in front
# for worktrees ("services/roadmap"), since the agents list otherwise shows
# several identical "on-demand-sr" rows. Reported when new or changed.
pane_cache="${TMPDIR:-/tmp}/herdr-pane-space.cache"
touch "$pane_cache"
pane_next=$(mktemp)

jq -r '
  .result.snapshot as $s
  | ($s.workspaces | map({
      key: .workspace_id,
      value: (if .worktree.is_linked_worktree then "\(.worktree.repo_name)/\(.label)" else .label end)
    }) | from_entries) as $names
  | $s.panes[] | [.pane_id, $names[.workspace_id]] | @tsv' <<< "$snapshot" \
  | while IFS=$'\t' read -r pane space; do
    if $full || ! grep -qxF "$pane"$'\t'"$space" "$pane_cache"; then
      "$herdr" pane report-metadata "$pane" --source koba-status --token "space=$space" > /dev/null
    fi
    printf '%s\t%s\n' "$pane" "$space" >> "$pane_next"
  done

mv "$pane_next" "$pane_cache"
