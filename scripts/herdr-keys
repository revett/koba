#!/usr/bin/env python3
# Lists the keybindings configured in config/herdr.toml (not herdr's
# defaults) and the Claude skills, then closes on any key. Bound to
# cmd+shift+/ as a popup.
import os
import sys
import termios
import tomllib
import tty

# Handled by Herdr.app itself rather than herdr's config.
APP_BINDINGS = [("cmd+q", "quit (detach)")]

path = os.environ.get("HERDR_CONFIG_PATH") or os.path.expanduser("~/.config/herdr/config.toml")
with open(path, "rb") as f:
    keys = tomllib.load(f).get("keys", {})

rows = []
for action, binding in keys.items():
    if action == "command":
        continue
    for key in binding if isinstance(binding, list) else [binding]:
        rows.append((key, action.replace("_", " ")))
for command in keys.get("command", []):
    rows.append((command["key"], command.get("description", command["command"])))
rows += APP_BINDINGS

# Claude skills, as in Koba's help overlay: directories holding a SKILL.md.
skills_dir = os.path.expanduser("~/.claude/skills")
skills = sorted(
    name for name in os.listdir(skills_dir)
    if os.path.isfile(os.path.join(skills_dir, name, "SKILL.md"))
) if os.path.isdir(skills_dir) else []

width = max(len(key) for key, _ in rows)
print("\n  keybindings\n")
for key, description in rows:
    print(f"  {key.ljust(width)}   {description}")
if skills:
    print("\n  claude skills\n")
    for name in skills:
        print(f"  /{name}")
print("\n  any key to close", end="", flush=True)

fd = sys.stdin.fileno()
saved = termios.tcgetattr(fd)
try:
    tty.setraw(fd)
    os.read(fd, 1)
finally:
    termios.tcsetattr(fd, termios.TCSADRAIN, saved)
