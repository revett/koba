#!/usr/bin/env bash
# Koba's command palette for the active herdr space. Bound to cmd+shift+p as
# a popup in config/herdr.toml; `herdr-palette switch` (cmd+k) opens the space
# switcher directly.
set -euo pipefail
source "$(dirname "$0")/herdr-lib.sh"

id="$HERDR_ACTIVE_WORKSPACE_ID"
cwd=$(terminal_pane "$id" | cut -f2)

# Shows a message until any key, so it outlives the popup.
fail() {
  printf '\n  %s\n\n  any key to close' "$1"
  read_key > /dev/null
  exit 1
}

# Every space as "<id>\t<line>", laid out like the sidebar: repos with their
# worktree spaces nested underneath, the current space marked, and each
# space's ticket and PR dimmed after its name. Worktrees carry their repo name
# ("docs/on-demand-sr", dimmed when nested) since fzf only searches what it
# shows, so searching a repo finds its worktrees too.
space_tree() {
  "$herdr" workspace list | jq -r '
    [.result.workspaces[] | {
      id: .workspace_id, label, focused,
      status: (.tokens.status // ""),
      linked: (.worktree.is_linked_worktree // false),
      repo: (.worktree.repo_root // ""),
      repo_name: (.worktree.repo_name // "")
    }] as $spaces
    | [$spaces[] | select(.linked | not)] as $roots
    | ($roots | map(.repo)) as $root_repos
    | (
        ($roots[] as $root
          | [$spaces[] | select(.linked and .repo != "" and .repo == $root.repo)] as $kids
          | [$root, ""],
            ($kids | to_entries[]
              | [.value, (if .key == ($kids | length) - 1 then "└ " else "├ " end)])),
        ($spaces[] | select(.linked and ([.repo] | inside($root_repos) | not))
          | [., "\(.repo_name)/"])
      )
    | . as [$space, $prefix]
    | "\($space.id)\t\(if $space.focused then "● " else "  " end)"
      + (if $prefix | test("^[├└]")
         then "  \($prefix)\u001b[2m\($space.repo_name)/\u001b[0m"
         else $prefix end)
      + $space.label
      + (if $space.status != "" then "  \u001b[2m\($space.status)\u001b[0m" else "" end)'
}

switch_space() {
  local target
  target=$(space_tree | fzf --prompt 'space > ' --reverse --ansi --no-sort \
    --delimiter '\t' --with-nth 2) || exit 0
  "$herdr" workspace focus "$(cut -f1 <<< "$target")" > /dev/null
}

# cmd+k goes straight to the space switcher.
if [[ "${1:-}" == "switch" ]]; then
  switch_space
  exit 0
fi

branch=$(git -C "$cwd" branch --show-current 2> /dev/null || true)
ticket=$(ticket_from_branch "$branch")
in_repo=$(git -C "$cwd" rev-parse --is-inside-work-tree 2> /dev/null || true)

choice=$(
  {
    [[ -n "$branch" ]] && echo 'GitHub → Open PR'
    [[ -n "$in_repo" ]] && echo 'GitHub → Open Repo'
    [[ -n "$ticket" ]] && echo "Linear → Open Ticket ($ticket)"
    echo 'Workspace → Update Title'
    echo 'Window → Switch Workspace'
  } | fzf --prompt '> ' --reverse
) || exit 0

case "$choice" in
  'GitHub → Open PR')
    (cd "$cwd" && gh pr view --web > /dev/null 2>&1) || fail "no PR for $branch"
    ;;
  'GitHub → Open Repo')
    (cd "$cwd" && gh repo view --web > /dev/null 2>&1) || fail 'not a GitHub repository'
    ;;
  'Linear → Open Ticket'*)
    # linear.app resolves /issue/<key> to the signed-in workspace.
    open "https://linear.app/issue/$ticket"
    ;;
  'Workspace → Update Title')
    read -rp 'title > ' title
    [[ -n "$title" ]] && "$herdr" workspace rename "$id" "$title" > /dev/null
    ;;
  'Window → Switch Workspace')
    switch_space
    ;;
esac
